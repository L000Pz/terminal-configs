{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "shell",
          "style": "powerline",
          "powerline_symbol": " ",
          "foreground": "#E6F1FF",
          "background": "#087EBD",
          "template": "  {{ if eq .Name \"pwsh\" }}󰨊{{ else }}{{ end }} {{ .Name }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#E6F1FF",
          "background": "#263D66",
          "template": "  {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#FFFFFF",
          "background": "#0757B8",
          "properties": {
            "style": "folder",
            "max_depth": 3,
            "folder_separator_icon": "  ",
            "home_icon": ""
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#F5E9FF",
          "background": "#59318C",
          "template": " {{ .HEAD }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if or (.Working.Changed) (.Staging.Changed) }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#E6F1FF",
          "background": "#203653",
          "properties": {
            "threshold": 500,
            "style": "roundrock"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#FFFFFF",
          "background": "#087F5B",
          "background_templates": [
            "{{ if gt .Code 0 }}#C92A2A{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if eq .Code 0 }}✔{{ else }}✘ {{ .Code }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#A9C7F5",
          "template": "PS {{ .PWD }} >"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#A9C7F5",
    "background": "transparent",
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "#A9C7F5",
    "background": "transparent",
    "template": "  ❯❯ "
  }
}
